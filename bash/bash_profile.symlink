# ~/.bash_profile — managed in ~/dotfiles/bash/bash_profile.symlink
#
# Login bash (what a terminal profile that runs bash starts). Environment only — the same
# shell/env.sh zsh uses, so PATH, node, JAVA_HOME, ... are identical in both shells. Interactive
# setup lives in ~/.bashrc, sourced at the end.

export DOTFILES="$HOME/dotfiles"
source "$DOTFILES/shell/env.sh"
export BASH_PROFILE_SOURCED=1

if [[ -f "$HOME/.bashrc" && -z "$BASHRC_SOURCED" ]]; then
  source "$HOME/.bashrc"
fi
