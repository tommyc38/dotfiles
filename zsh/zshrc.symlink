# ~/.zshrc — managed in ~/dotfiles/zsh/zshrc.symlink
#
# Layout (bash mirrors it in bash/):
#   shell/env.sh     PATH, Homebrew, GNU tools, default node, pyenv PATH, JAVA_HOME — shared with bash
#   shell/*.sh       aliases + functions shared with bash (git, tmux, helpers)
#   zsh/*.zsh        zsh-only config (options, prompt, colours)
#
# IntelliJ/WebStorm source this file with INTELLIJ_ENVIRONMENT_READER set just to harvest the
# environment (PATH, JAVA_HOME, node, ...). Anything interactive or slow is skipped in that case.

export DOTFILES=$HOME/dotfiles
export ZSH=$DOTFILES/zsh
source "$DOTFILES/shell/env.sh"

# Work environment (tokens, API keys) for the folder we start in — also for IntelliJ's env reader, so
# npm/pnpm run from the IDE get the same credentials as the terminal. See shell/workenv-auto.sh.
source "$DOTFILES/shell/workenv-auto.sh"
_workenv_auto

if [[ -z "$INTELLIJ_ENVIRONMENT_READER" ]]; then
  # --- SSH keys -----------------------------------------------------------------------------------
  # macOS's launchd agent is shared by every shell, so this only does work after a reboot/login, and
  # ~/.ssh/config (AddKeysToAgent + UseKeychain) covers anything it misses.
  if [[ -d "$DOTFILES/vault-key" ]] && ! ssh-add -l >/dev/null 2>&1; then
    bash "$DOTFILES/bin/ssh-setup.sh" >/dev/null 2>&1
  fi

  # --- Aliases, functions, zsh options/prompt -----------------------------------------------------
  for config in $DOTFILES/shell/*.sh(N) $ZSH/**/*.zsh(N); do
    [[ "$config" == */env.sh || "$config" == */workenv-auto.sh ]] || source $config
  done
  unset config
fi
workenv() {
  . "$DOTFILES/bin/workenv.sh" "$@"
}

# --- Interactive niceties -------------------------------------------------------------------------
alias ls="ls --color"
export LS_COLORS='or=5;31:mi=5:ow=01;91'
alias info='info --vi-keys'

if [[ -z "$INTELLIJ_ENVIRONMENT_READER" ]]; then
  autoload -U compinit add-zsh-hook
  add-zsh-hook chpwd _workenv_auto   # switch work environment by folder on cd
  # Full security audit at most once a day; otherwise reuse the cached dump (-C). The glob qualifier
  # needs extendedglob, and touch makes "once a day" hold even when compinit doesn't rewrite the dump.
  () {
    setopt local_options extended_glob
    local dump=${ZDOTDIR:-$HOME}/.zcompdump
    if [[ ! -f $dump || -n $dump(#qN.mh+24) ]]; then
      compinit -i && touch $dump
    else
      compinit -C -i
    fi
  }

  BASE16_SHELL="$HOME/.config/base16-shell/"
  [[ -n "$PS1" && -s "$BASE16_SHELL/profile_helper.sh" ]] && eval "$("$BASE16_SHELL/profile_helper.sh")"

  [[ -s "$HOMEBREW_PREFIX/etc/profile.d/autojump.sh" ]] && . "$HOMEBREW_PREFIX/etc/profile.d/autojump.sh"

  if [[ -z ${DOTFILES_LOADED+x} ]]; then
    for _plugin in zsh-syntax-highlighting zsh-autosuggestions; do
      [[ -f "$HOMEBREW_PREFIX/share/$_plugin/$_plugin.zsh" ]] && source "$HOMEBREW_PREFIX/share/$_plugin/$_plugin.zsh"
    done
    unset _plugin
  fi

  for config ($ZSH/**/*completion.sh(N)) source $config
  unset config

  # --- nvm (default node is already on PATH via shell/env.sh) -------------------------------------
  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    \. "$NVM_DIR/nvm.sh" --no-use
    [[ -s "$NVM_DIR/bash_completion" ]] && \. "$NVM_DIR/bash_completion"
    [[ -n "$DOTFILES_NVM_DEFAULT_BIN" ]] || nvm use --silent default >/dev/null 2>&1
    add-zsh-hook chpwd load-nvmrc # switch node versions on cd (shell/functions.sh)
  fi

  # --- pyenv --------------------------------------------------------------------------------------
  if command -v pyenv >/dev/null; then
    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"
    pyenv commands 2>/dev/null | grep -qx virtualenv-init && eval "$(pyenv virtualenv-init -)"
  fi
fi

export DOTFILES_LOADED=1

# --- Tungsten Cloud -------------------------------------------------------------------------------
# The marked block below is owned by `pnpm dev:setup` in the Tungsten eng-* repos (tools/dev/setup.sh).
# Every run deletes it and re-appends it at the END of this file, so keep it last and add nothing
# after it. bash/bashrc.symlink evaluates it from here (dotfiles_load_tng_block). Registries are NOT set
# here: workenv layers them per folder (shell/workenv-auto.sh) — run dev:setup with TNG_SETUP_REGISTRY=public.
# The CA chain it points at is symlinked from the vault (vault-key/symlinks.txt).
# >>> tng dev:setup >>>
export NODE_EXTRA_CA_CERTS="$HOME/.certs/tungsten-ca-chain.pem"
# <<< tng dev:setup <<<
