# Shared git config. NOT symlinked: ~/.gitconfig is a local file that [include]s this one (install.sh
# `symlinks` step), so `git config --global ...` writes from tools (gh, git-lfs, credential helpers)
# land in the local file instead of this public repo. Local settings override these.

[user]
	name = Tom Conley
	email = tommyc38@gmail.com

# Work identities, auto-applied by folder (the included files live in the encrypted vault).
# Tungsten Cloud GHE — any repo under ~/dev/tungsten/tungsten-cloud/
[includeIf "gitdir:~/dev/tungsten/tungsten-cloud/"]
	path = ~/dotfiles/vault-key/tungsten/tungsten-cloud.gitconfig

# Printix + Tungsten Automation PM (github.com) — work email and the printix SSH key, under ~/dev/tungsten/printix/
[includeIf "gitdir:~/dev/tungsten/printix/"]
	path = ~/dotfiles/vault-key/tungsten/printix.gitconfig

[core]
	excludesfile = ~/dotfiles/git/gitignore_global

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
	# `gs` and `g` (shell/git.sh) expect this alias.
	s = status -sb
