# Shared git config. NOT symlinked: ~/.gitconfig is a local file that [include]s this one (install.sh
# `symlinks` step), so `git config --global ...` writes from tools (gh, git-lfs, credential helpers)
# land in the local file instead of this public repo. Local settings override these.

[user]
	name = Tom Conley
	email = tommyc38@gmail.com

# Enterprise (Tungsten Cloud) identity — auto-applied to any repo under ~/dev/tungsten-cloud/
# (the included file lives in the encrypted vault).
[includeIf "gitdir:~/dev/tungsten-cloud/"]
	path = ~/dotfiles/vault-key/tungsten-cloud/gitconfig

# Printix identity — auto-applied to any repo under ~/dev/printix/ (Printix + Tungsten Automation PM orgs).
[includeIf "gitdir:~/dev/printix/"]
	path = ~/dotfiles/vault-key/kofax/gitconfig

[core]
	excludesfile = ~/dotfiles/git/gitignore_global

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
	# `gs` and `g` (shell/git.sh) expect this alias.
	s = status -sb
