{
    // Managed in ~/dotfiles/vscode/settings.json (linked by bin/symlink.sh --include-editors).
    // Old Windows-era settings are kept for reference in vscode/legacy/ (not linked).

    // Terminal: zsh by default, bash one click away (terminal dropdown / "Terminal: Select Default Profile").
    // Login shells (-l) so they load ~/.zprofile / ~/.bash_profile like a macOS terminal does.
    // Each path lists Apple Silicon, Intel, then the system shell as fallbacks.
    "terminal.integrated.profiles.osx": {
        "zsh": {
            "path": ["/opt/homebrew/bin/zsh", "/usr/local/bin/zsh", "/bin/zsh"],
            "args": ["-l"],
            "icon": "terminal"
        },
        "bash": {
            "path": ["/opt/homebrew/bin/bash", "/usr/local/bin/bash", "/bin/bash"],
            "args": ["-l"],
            "icon": "terminal-bash"
        }
    },
    "terminal.integrated.defaultProfile.osx": "zsh"
}
